{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/feedback/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Mamba|Pacifico|Poppins))/i]",
        "message": "Font not provided by the design system. Available: Mamba, Pacifico, Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|onClick|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, onClick, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CuratorCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|bio|quote|stampSrc|key|ref|className|style|children)$/]",
        "message": "<CuratorCard> doesn't accept that prop. Declared props: name, role, bio, quote, stampSrc."
      },
      {
        "selector": "JSXOpeningElement[name.name='InspectionStamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:inspector|label|passed|size|key|ref|className|style|children)$/]",
        "message": "<InspectionStamp> doesn't accept that prop. Declared props: inspector, label, passed, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='InspectionStamp'] > JSXAttribute[name.name='inspector'] > Literal[value!=/^(?:Milo|Daisy|Malibu|Tatiana)$/]",
        "message": "<InspectionStamp> inspector must be one of 'Milo' | 'Daisy' | 'Malibu' | 'Tatiana'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|name|era|materials|price|status|curator|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: image, name, era, materials, price, status, curator."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:available|sold)$/]",
        "message": "<ProductCard> status must be one of 'available' | 'sold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|mustard|avocado|orange)$/]",
        "message": "<Tag> tone must be one of 'cream' | 'mustard' | 'avocado' | 'orange'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
      "CuratorCard": {
        "replaces": []
      },
      "InspectionStamp": {
